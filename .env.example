# npm run setup generates random local credentials. Never commit .env.
DATABASE_URL="postgresql://flowteam:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55437/flowteam"
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# On serverless hosts local attachments are disabled; configure durable private storage first.

# Optional: also use private PostgreSQL blobs locally (automatic on Vercel).
# Limits: 1 MiB/file, 5 MiB/workspace, 100 MiB total binary data.
